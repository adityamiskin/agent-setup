[Unit]
Description=Block lid-close suspend while Omarchy "stay awake" is enabled

[Service]
Type=simple
# Holds the inhibitor only while the Omarchy stay-awake flag exists. A block-mode
# handle-lid-switch inhibitor makes logind ignore lid events, so closing the lid
# no longer suspends. The poll is what releases the inhibitor as soon as the
# flag goes away (systemd path units can trigger a start, not a stop).
ExecStart=/usr/bin/systemd-inhibit --what=handle-lid-switch:sleep --who=Omarchy --why="Stay awake with lid closed" --mode=block /usr/bin/bash -c 'while test -e "%h/.local/state/omarchy/indicators/stay-awake"; do sleep 2; done'
