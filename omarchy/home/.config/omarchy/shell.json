{
  "bar": {
    "centerAnchor": "aditya.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "format": "dddd h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "aditya.clock",
          "verticalFormat": "h\n\u2014\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "autoCheckUpdates": true,
          "id": "omaplug"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "evindor.keystroke"
        },
        {
          "id": "aditya.workspace-icons"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.simonschubert.omalauncher"
        },
        {
          "id": "adityamiskin.wallpaper-colors"
        },
        {
          "id": "meviusisback.hw-monitor",
          "mode": "icons",
          "ramFormat": "used/total",
          "showCpuTemp": false,
          "showGauges": false,
          "showGpu": false,
          "topProcGroup": true,
          "topProcSort": "ram"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "evindor.keystroke"
    },
    {
      "id": "aditya.desktop-widgets"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "evindor.keystroke"
  ]
}
