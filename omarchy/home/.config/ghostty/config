# Dynamic theme colors
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Ghostty daily-driver configuration
# Reload after edits with Ctrl+Shift+Comma.

# Typography
command = /usr/bin/fish
font-family = MesloLGS Nerd Font Mono
font-size = 10
font-feature = calt
font-feature = liga
font-feature = zero
adjust-cell-height = 8%

minimum-contrast = 1.1
background-opacity = 1.0
background-blur = 0
unfocused-split-opacity = 0.88

# Cursor and selection
cursor-style = block
cursor-style-blink = false
cursor-click-to-move = true
mouse-hide-while-typing = true
selection-clear-on-copy = false

# Window chrome and layout
window-decoration = none
gtk-titlebar = false
window-padding-x = 6
window-padding-y = 10
window-padding-balance = false
window-theme = ghostty
window-show-tab-bar = auto
gtk-tabs-location = top
gtk-wide-tabs = false
resize-overlay = never

# Terminal behavior
scrollback-limit = 50000000
# Finer touchpad scroll increments; keep mouse-wheel steps unchanged.
mouse-scroll-multiplier = precision:0.65,discrete:3
copy-on-select = true
clipboard-read = ask
clipboard-write = allow
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
confirm-close-surface = false
shell-integration = fish
shell-integration-features = cursor,title,ssh-env,ssh-terminfo,path

# Convenient additions to Ghostty's excellent default bindings.
# Tabs: Ctrl+Shift+T, Ctrl+Tab / Ctrl+Shift+Tab, Alt+1..9
# Search: Ctrl+Shift+F | command palette: Ctrl+Shift+P
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+alt+d=new_split:down
keybind = alt+shift+arrow_left=goto_split:left
keybind = alt+shift+arrow_down=goto_split:down
keybind = alt+shift+arrow_up=goto_split:up
keybind = alt+shift+arrow_right=goto_split:right
keybind = ctrl+alt+shift+arrow_left=resize_split:left,10
keybind = ctrl+alt+shift+arrow_down=resize_split:down,10
keybind = ctrl+alt+shift+arrow_up=resize_split:up,10
keybind = ctrl+alt+shift+arrow_right=resize_split:right,10
keybind = ctrl+shift+backslash=equalize_splits
keybind = ctrl+shift+enter=toggle_split_zoom
keybind = ctrl+shift+comma=reload_config
