#!/usr/bin/env bash
# caffeinate -- keep the machine running with the lid closed.
#
# Omarchy's "stay awake" flag (coffee cup in the bar, SUPER+CTRL+I) only stops
# the idle lock/screensaver. It does not stop logind from suspending on lid
# close. This wraps that flag so it means the same thing there:
#
#   flag on  ->  a systemd inhibitor blocks lid-close/sleep, and closing the
#               lid locks the session and powers the panel down instead.
#   flag off ->  stock Omarchy behavior: lock + suspend on lid close.
#
# Usage:
#   caffeinate [on|off|toggle|status]
#   caffeinate lid-close | lid-open        (called by the Hyprland lid binds)

set -uo pipefail

FLAG="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/indicators/stay-awake"
SERVICE=caffeinate-lid.service

internal_monitor() { omarchy-hyprland-monitor-laptop 2>/dev/null; }

is_on() { [[ -e $FLAG ]]; }

panel() {
  local action=$1 monitor
  monitor=$(internal_monitor)
  [[ -n $monitor ]] || return 0
  hyprctl dispatch "hl.dsp.dpms({ action = \"$action\", monitor = \"$monitor\" })" >/dev/null 2>&1 || true
}

lid_close() {
  # Not caffeinated: hand it back to Omarchy (lock, then logind suspends).
  is_on || exec omarchy-system-lid-close

  # Same lock policy as omarchy-system-lid-close: lock on a plain lid close,
  # but not in clamshell mode where an external display is in use.
  if omarchy-hw-laptop-closed && ! omarchy-hw-external-monitors; then
    omarchy-system-lock >/dev/null 2>&1 || true
  fi

  panel disable
}

lid_open() {
  is_on && panel enable
  exec omarchy-hyprland-monitor-clamshell
}

case "${1:-toggle}" in
  on | stay-awake)
    omarchy toggle idle stay-awake >/dev/null
    ;;
  off | allow-idle)
    omarchy toggle idle allow-idle >/dev/null
    ;;
  toggle)
    if is_on; then
      omarchy toggle idle allow-idle >/dev/null
    else
      omarchy toggle idle stay-awake >/dev/null
      # Lid already shut: blank now instead of waiting for the next event.
      if omarchy-hw-laptop-closed; then panel disable; fi
    fi
    ;;
  status)
    if is_on; then
      printf 'on'
      if systemctl --user is-active --quiet "$SERVICE"; then
        printf ' (lid suspend blocked)'
      else
        printf ' (inhibitor starting)'
      fi
      printf '\n'
    else
      printf 'off\n'
    fi
    ;;
  lid-close) lid_close ;;
  lid-open) lid_open ;;
  *)
    echo "usage: caffeinate [on|off|toggle|status]" >&2
    exit 2
    ;;
esac
